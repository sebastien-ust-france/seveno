# Stripe Checkout. Never commit real values.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_ENVIRONMENT=test

# Secret values, supplied by local environment or Secret Manager.
STRIPE_SECRET_KEY=replace-with-environment-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-environment-webhook-secret

# Non-secret catalogue configuration. Test and live IDs must remain distinct.
STRIPE_PRICE_CAMPAIGN_CREDIT_1_TEST=price_test_placeholder
STRIPE_PRICE_CAMPAIGN_CREDIT_3_TEST=price_test_placeholder
STRIPE_PRICE_CAMPAIGN_CREDIT_10_TEST=price_test_placeholder
STRIPE_PRICE_CAMPAIGN_EXTENSION_30D_TEST=price_test_placeholder
STRIPE_PRICE_QUALIFIED_CANDIDATES_10_TEST=price_test_placeholder

STRIPE_PRICE_CAMPAIGN_CREDIT_1_LIVE=price_live_placeholder
STRIPE_PRICE_CAMPAIGN_CREDIT_3_LIVE=price_live_placeholder
STRIPE_PRICE_CAMPAIGN_CREDIT_10_LIVE=price_live_placeholder
STRIPE_PRICE_CAMPAIGN_EXTENSION_30D_LIVE=price_live_placeholder
STRIPE_PRICE_QUALIFIED_CANDIDATES_10_LIVE=price_live_placeholder

SEVENO_PUBLIC_ORIGIN=http://localhost:3001
